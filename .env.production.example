# ══════════════════════════════════════════════════════════════════════════════
# Farm360 AI / LLM — Production Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════
# Environment: PRODUCTION (Live cloud cluster / highly-available deployment)
#
# Usage:
#   Inject these environment variables directly via your cloud secrets manager
#   (e.g. AWS Secrets Manager / Parameter Store, GCP Secret Manager, Vault, or
#   Kubernetes SealedSecrets).
#
# Notes:
#   - In production (ENVIRONMENT=production), strict fail-fast validation is active:
#       * FARM360_ENCRYPTION_KEY must be a valid 32-byte Fernet key (startup fails if missing).
#       * CORS_ORIGINS must be non-empty and cannot contain wildcards '*' (startup fails if invalid).
#   - NEVER store plaintext secrets in repository files or Docker images.
#   - All secret variables below use '<SET_IN_SECRET_MANAGER>' placeholders.
# ══════════════════════════════════════════════════════════════════════════════

# ==============================================================================
# 1. RUNTIME & AUTHENTICATION SECRETS (MANDATORY IN PRODUCTION)
# ==============================================================================
# Runtime environment identifier (enforces production fail-fast checks)
ENVIRONMENT=production

# [SECRET - MANDATORY] Cryptographically random secret key for server-to-server proxy.
# Header: X-API-Key. Generate via: python -c "import secrets; print(f'fk-{secrets.token_urlsafe(32)}')"
FARM360_API_KEY=<SET_IN_SECRET_MANAGER>

# [SECRET - MANDATORY] 32-byte URL-safe base64 Fernet AES-256 master key for PII encryption.
# Startup will halt immediately if unset or invalid. Store securely in KMS / Vault.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FARM360_ENCRYPTION_KEY=<SET_IN_SECRET_MANAGER_32_BYTE_FERNET>

# ==============================================================================
# 2. FRONTEND & DOMAIN CONNECTIVITY (CADDY & NEXT.JS PROXY)
# ==============================================================================
# Production domain for Caddy TLS termination and automatic Let's Encrypt certificates.
# Set to an FQDN (e.g. app.farm360.ai) or ':80' for initial AWS EC2 IP testing.
DOMAIN=app.farm360.ai

# Internal Docker Compose service URL used by Next.js server to route requests to backend.
# Private non-public endpoint within the farm360-prod-net network.
BACKEND_API_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=http://backend:8000

# ==============================================================================
# 3. DATABASE & DISTRIBUTED CACHE (DOCKER COMPOSE OR MANAGED CLOUD)
# ==============================================================================
# Containerized PostgreSQL 16 + pgvector credentials
POSTGRES_USER=farm360_user
POSTGRES_PASSWORD=<SET_IN_SECRET_MANAGER>
POSTGRES_DB=farm360_prod

# Full connection string for FastAPI backend (auto-derived in Compose if omitted)
DATABASE_URL=postgresql+asyncpg://farm360_user:<SET_IN_SECRET_MANAGER>@postgres:5432/farm360_prod

# Redis L2 cache endpoint within Docker Compose network
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Redis Authentication & TLS (set REDIS_PASSWORD if auth enabled; false inside internal network)
REDIS_PASSWORD=<SET_IN_SECRET_MANAGER_OR_LEAVE_BLANK>
REDIS_SSL=false

# ==============================================================================
# 4. LLM & VISION PROVIDER API KEYS (ENTERPRISE MONITORED POOLS)
# ==============================================================================
# Multi-key pools with automatic round-robin rotation on rate limits (429/quota).
# Managed via Secret Manager. Unused slots can safely remain empty.

# Google Gemini (Primary Provider) — Tier 1 Production Keys
GOOGLE_API_KEY_1=<SET_IN_SECRET_MANAGER>
GOOGLE_API_KEY_2=<SET_IN_SECRET_MANAGER>
GOOGLE_API_KEY_3=<SET_IN_SECRET_MANAGER>
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=

# OpenRouter (Fallback Provider) — High-Availability Fallback Pool
OPENROUTER_API_KEY_1=<SET_IN_SECRET_MANAGER>
OPENROUTER_API_KEY_2=<SET_IN_SECRET_MANAGER>
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=

# OpenAI (Optional Fallback)
OPENAI_API_KEY_1=<SET_IN_SECRET_MANAGER>
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

# ==============================================================================
# 5. TELEMETRY, MODELS & CORS SETTINGS
# ==============================================================================
# Production OpenWeather API key for farm telemetry
OPENWEATHER_API_KEY=<SET_IN_SECRET_MANAGER>

# Base path for model binaries inside immutable production container image
MODEL_BASE_PATH=/app

# [MANDATORY] Allowed CORS origins for production domain(s) (comma-separated).
# Wildcard '*' is strictly forbidden and will trigger a startup ValueError.
CORS_ORIGINS=https://app.farm360.ai,https://farm360.ai
