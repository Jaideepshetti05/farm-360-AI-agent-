# ══════════════════════════════════════════════════════════════════════════════
# Farm360 AI / LLM — Development Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════
# Environment: DEVELOPMENT (Local workstation / Docker Compose local dev)
#
# Usage:
#   cp .env.development.example .env
#   (or for local Next.js frontend: cp .env.development.example frontend/.env.local)
#
# Notes:
#   - Safe local defaults are provided below for zero-friction local development.
#   - In development mode (ENVIRONMENT=development), strict production fail-fast
#     checks are relaxed (e.g. localhost CORS permitted, fallback encryption allowed).
#   - NEVER commit real API keys or credentials to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ==============================================================================
# 1. RUNTIME & AUTHENTICATION SECRETS
# ==============================================================================
# Runtime environment identifier (must be 'development' for local work)
ENVIRONMENT=development

# [SECRET] Shared API key for Next.js server proxy → FastAPI backend requests.
# Header: X-API-Key. Client browsers NEVER receive this key.
# For local dev, any non-empty string works.
FARM360_API_KEY=dev-farm360-api-key-local

# [SECRET / OPTIONAL IN DEV] 32-byte URL-safe base64 Fernet key for PII encryption.
# In development, if left empty, an in-memory fallback key with a warning is used.
# To test production-grade encryption locally, generate a key via:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FARM360_ENCRYPTION_KEY=

# ==============================================================================
# 2. FRONTEND CONNECTIVITY (NEXT.JS SERVER-SIDE PROXY)
# ==============================================================================
# Internal URL used by Next.js server-side route handlers to reach the backend.
# Local non-Docker development: http://127.0.0.1:8000
# Docker Compose development:   http://farm360-backend:8000
BACKEND_API_URL=http://127.0.0.1:8000

# Public API base URL (used only as fallback; client browser routes via server proxy)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ==============================================================================
# 3. DATABASE & DISTRIBUTED CACHE
# ==============================================================================
# Database connection string:
# - Local zero-setup SQLite fallback (default if empty):
#   sqlite+aiosqlite:///./farm360.db
# - Local Docker Compose PostgreSQL:
#   postgresql+asyncpg://postgres:postgres@localhost:5432/farm360
DATABASE_URL=sqlite+aiosqlite:///./farm360.db

# Redis L2 cache settings (falls back to local in-memory L1 cache if offline)
# Local standalone: 127.0.0.1 | Docker Compose: redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Redis Authentication & TLS (Optional in DEV; leave empty / false for local Redis)
REDIS_PASSWORD=
REDIS_SSL=false

# ==============================================================================
# 4. LLM & VISION PROVIDER API KEYS (DEVELOPMENT / SANDBOX KEYS)
# ==============================================================================
# At least 1 valid API key is required to enable interactive LLM chat features.
# Unused slots can safely remain empty.

# Google Gemini (Primary Provider) — Get free keys: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=

# OpenRouter (Fallback Provider) — Get keys: https://openrouter.ai/keys
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=

# OpenAI (Optional Fallback) — Get keys: https://platform.openai.com/api-keys
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

# ==============================================================================
# 5. TELEMETRY, MODELS & CORS SETTINGS
# ==============================================================================
# OpenWeather API key for live farm weather telemetry (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Base path for local ML model binaries (empty defaults to project root)
MODEL_BASE_PATH=

# Allowed CORS origins for browser access (comma-separated)
# In development, defaults to localhost:3000 if unset.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
