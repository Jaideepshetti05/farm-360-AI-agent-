# ══════════════════════════════════════════════════════════════════════════════
# Farm360 AI / LLM — Root Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` in the repository root:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ==============================================================================
# 1. RUNTIME & AUTHENTICATION SECRETS
# ==============================================================================
# Runtime environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# [REQUIRED] Secret key shared between Next.js server proxy and FastAPI backend.
# Client browsers NEVER receive this key.
FARM360_API_KEY=<SET_IN_DEPLOYMENT_ENVIRONMENT>

# [REQUIRED IN PRODUCTION] 32-byte Fernet AES-256 key for transparent PII encryption.
# In production (ENVIRONMENT=production), startup fails if unset.
FARM360_ENCRYPTION_KEY=<SET_32_BYTE_FERNET_KEY_IN_PRODUCTION>

# ==============================================================================
# 2. FRONTEND CONNECTIVITY (NEXT.JS SERVER-SIDE PROXY)
# ==============================================================================
# Internal URL used by Next.js server routes to reach the backend.
# For local development: http://127.0.0.1:8000
# For Docker Compose:    http://farm360-backend:8000
BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ==============================================================================
# 3. DATABASE & DISTRIBUTED CACHE
# ==============================================================================
# PostgreSQL async connection string (e.g. AWS RDS / Cloud SQL).
# If omitted, automatically defaults to local SQLite: sqlite+aiosqlite:///./farm360.db
DATABASE_URL=postgresql+asyncpg://postgres:<DB_PASSWORD>@localhost:5432/farm360

# Redis distributed L2 cache (falls back to local in-memory L1 cache if offline)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ==============================================================================
# 4. LLM & VISION PROVIDER API KEYS (AT LEAST 1 KEY REQUIRED)
# ==============================================================================
# Google Gemini (Primary Provider) — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=

# OpenRouter (Fallback Provider) — https://openrouter.ai/keys
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=

# OpenAI (Optional Fallback) — https://platform.openai.com/api-keys
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

# ==============================================================================
# 5. OPTIONAL TELEMETRY & CORS SETTINGS
# ==============================================================================
# OpenWeather API key for live farm weather telemetry (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Base path for local ML models (defaults to project root)
MODEL_BASE_PATH=

# Allowed CORS origins for browser access (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
