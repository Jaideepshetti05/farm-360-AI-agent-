# ══════════════════════════════════════════════════════════════════════════════
# Farm360 AI / LLM — Staging Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════
# Environment: STAGING (Pre-production QA / staging cluster / release validation)
#
# Usage:
#   Inject these environment variables via your cloud staging deployment platform
#   (e.g. AWS ECS/EKS task definition, GCP Cloud Run, Kubernetes Secrets, or CI/CD).
#
# Notes:
#   - Staging mirrors production architecture while connecting to isolated staging
#     data stores and quota-capped API providers.
#   - Explicit CORS domains and dedicated staging credentials must be configured.
#   - NEVER use production encryption keys, customer data, or production DB credentials.
# ══════════════════════════════════════════════════════════════════════════════

# ==============================================================================
# 1. RUNTIME & AUTHENTICATION SECRETS
# ==============================================================================
# Runtime environment identifier (recognized as first-class staging mode)
ENVIRONMENT=staging

# [SECRET - REQUIRED] Dedicated secret key for Next.js proxy → backend authentication.
# Header: X-API-Key. Generate a secure 32+ character random string.
FARM360_API_KEY=<SET_DEDICATED_STAGING_API_KEY>

# [SECRET - RECOMMENDED] Dedicated 32-byte URL-safe base64 Fernet encryption key.
# Keep distinct from production to ensure cryptographic isolation between tiers.
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FARM360_ENCRYPTION_KEY=<SET_STAGING_32_BYTE_FERNET_KEY>

# ==============================================================================
# 2. FRONTEND CONNECTIVITY (NEXT.JS SERVER-SIDE PROXY)
# ==============================================================================
# Internal service mesh / VPC URL used by Next.js server to route requests to backend.
# In staging Docker/K8s: http://farm360-backend:8000 or internal staging DNS
BACKEND_API_URL=http://farm360-backend:8000

# Public API domain for staging (fallback reference)
NEXT_PUBLIC_API_BASE_URL=https://staging-api.farm360.ai

# ==============================================================================
# 3. DATABASE & DISTRIBUTED CACHE
# ==============================================================================
# Dedicated Staging PostgreSQL 16 + pgvector connection string.
# Points to isolated staging database instance (e.g. AWS RDS Staging / GCP Cloud SQL).
DATABASE_URL=postgresql+asyncpg://farm360_staging_user:<SET_STAGING_DB_PASSWORD>@staging-postgres.internal:5432/farm360_staging

# Staging Redis L2 distributed cache endpoint
REDIS_HOST=staging-redis.internal
REDIS_PORT=6379
REDIS_DB=0

# Redis Authentication & TLS (Staging cloud instances should enable authentication and TLS)
REDIS_PASSWORD=<SET_STAGING_REDIS_PASSWORD>
REDIS_SSL=true

# ==============================================================================
# 4. LLM & VISION PROVIDER API KEYS (STAGING QUOTA-CONTROLLED POOL)
# ==============================================================================
# Dedicated staging API keys with monitored cost limits. Leave unused slots empty.

# Google Gemini (Primary Provider)
GOOGLE_API_KEY_1=<SET_STAGING_GEMINI_KEY_1>
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_API_KEY_5=

# OpenRouter (Fallback Provider)
OPENROUTER_API_KEY_1=<SET_STAGING_OPENROUTER_KEY_1>
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=

# OpenAI (Optional Fallback)
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

# ==============================================================================
# 5. TELEMETRY, MODELS & CORS SETTINGS
# ==============================================================================
# Staging OpenWeather API key
OPENWEATHER_API_KEY=<SET_STAGING_OPENWEATHER_KEY>

# Base path for model binaries inside immutable container image
MODEL_BASE_PATH=/app

# Allowed CORS origins for staging web domain (comma-separated, no wildcards)
CORS_ORIGINS=https://staging.farm360.ai
